// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  name              String?
  avatar            String?
  trialStartedAt    DateTime  @default(now())
  trialEndsAt       DateTime
  isTrialActive     Boolean   @default(true)
  stripeCustomerId  String?   @unique
  stripeSubId       String?
  subStatus         String?   @default("trialing")
  subPlan           String?   @default("free")
  resetToken        String?
  resetTokenExpiry  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Referral fields
  referralCode      String?   @unique
  referralCredits   Int       @default(0)
  referredBy        String?

  // Relations
  instagramAccount  InstagramAccount?
  aiSettings        AISettings?
  conversations     Conversation[]
  leads             Lead[]
  automationLogs    AutomationLog[]
  billingEvents     BillingEvent[]
  keywordRules      KeywordRule[]
  reelContexts      ReelContext[]
  referralEvents    ReferralEvent[]   @relation("ReferrerEvents")
  referredEvents    ReferralEvent[]   @relation("ReferredEvents")

  @@map("users")
}

model InstagramAccount {
  id              String    @id @default(cuid())
  userId          String    @unique
  igUserId        String    @unique
  username        String
  accessToken     String
  tokenExpiry     DateTime?
  pageId          String?
  pageToken       String?
  isActive        Boolean   @default(true)
  automationOn    Boolean   @default(false)
  webhookVerified Boolean   @default(false)
  followerCount   Int?
  profilePicUrl   String?
  connectedAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("instagram_accounts")
}

model AISettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  businessName        String?
  businessDescription String?
  productDetails      String?
  targetAudience      String?
  goal                String   @default("engagement")
  tone                String   @default("friendly")
  customInstructions  String?
  replyToDMs          Boolean  @default(true)
  replyToComments     Boolean  @default(true)
  autoSendDMs         Boolean  @default(true)
  maxDMsPerHour       Int      @default(20)
  maxRepliesPerHour   Int      @default(30)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

model Conversation {
  id              String    @id @default(cuid())
  userId          String
  igThreadId      String?   @unique
  igUserId        String
  igUsername      String?
  igProfilePic    String?
  source          String    @default("dm")
  status          String    @default("active")
  automationOn    Boolean   @default(true)
  lastMessageAt   DateTime  @default(now())
  messageCount    Int       @default(0)
  aiMessageCount  Int       @default(0)
  isLead          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        Message[]
  lead            Lead?

  @@index([userId])
  @@index([igUserId])
  @@map("conversations")
}

model Message {
  id              String    @id @default(cuid())
  conversationId  String
  igMessageId     String?   @unique
  direction       String
  senderType      String    @default("user")
  content         String
  mediaUrl        String?
  mediaType       String?
  isRead          Boolean   @default(false)
  sentAt          DateTime  @default(now())
  deliveredAt     DateTime?
  failedAt        DateTime?
  retryCount      Int       @default(0)
  metadata        Json?

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model Lead {
  id              String    @id @default(cuid())
  userId          String
  conversationId  String?   @unique
  igUserId        String
  igUsername      String?
  igProfilePic    String?
  name            String?
  email           String?
  phone           String?
  notes           String?
  status          String    @default("new")
  source          String    @default("dm")
  value           Float?
  tags            String[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation    Conversation? @relation(fields: [conversationId], references: [id])

  @@index([userId])
  @@map("leads")
}

model AutomationLog {
  id          String   @id @default(cuid())
  userId      String
  type        String
  status      String   @default("success")
  source      String?
  igUserId    String?
  messageId   String?
  response    String?
  error       String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("automation_logs")
}

model BillingEvent {
  id              String   @id @default(cuid())
  userId          String
  stripeEventId   String   @unique
  type            String
  status          String   @default("processed")
  amount          Int?
  currency        String?
  metadata        Json?
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("billing_events")
}

model KeywordRule {
  id           String   @id @default(cuid())
  userId       String
  mediaId      String?
  mediaUrl     String?
  mediaCaption String?
  keyword      String
  replyText    String
  source       String   @default("both")
  isActive     Boolean  @default(true)
  matchType    String   @default("contains")
  dmReplyText  String?
  autoDM       Boolean  @default(false)
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mediaId])
  @@map("keyword_rules")
}

model ReelContext {
  id            String   @id @default(cuid())
  userId        String
  mediaId       String
  caption       String?
  mediaType     String?
  thumbnailUrl  String?
  permalink     String?
  customContext String?
  aiGoal        String?
  aiTone        String?
  isActive      Boolean  @default(true)
  cachedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([userId])
  @@index([mediaId])
  @@map("reel_contexts")
}

model ReferralEvent {
  id          String    @id @default(cuid())
  referrerId  String
  referredId  String
  status      String    @default("pending")  // pending | converted
  rewardDays  Int       @default(7)
  convertedAt DateTime?
  createdAt   DateTime  @default(now())

  referrer    User      @relation("ReferrerEvents", fields: [referrerId], references: [id], onDelete: Cascade)
  referred    User      @relation("ReferredEvents", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([referredId])
  @@map("referral_events")
}
